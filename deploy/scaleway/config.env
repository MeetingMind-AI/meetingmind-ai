# Scaleway cloud lifecycle — tunable defaults.
# These are safe to commit (no secrets). Secrets come from GitHub Actions
# secrets / environment (see deploy/scaleway/README.md).

# --- Where / what -----------------------------------------------------------
# Zones with L4 GPU stock: fr-par-2, fr-par-1, pl-waw-2
export MM_ZONE="${MM_ZONE:-fr-par-2}"

# GPU instance type. L4-1-24G = 1x NVIDIA L4 (24GB VRAM), 8 vCPU, 48GB RAM.
export MM_SERVER_TYPE="${MM_SERVER_TYPE:-L4-1-24G}"

# GPU OS image: Ubuntu 24.04 with NVIDIA driver + Docker + NVIDIA Container
# Toolkit pre-installed. Use ubuntu_noble_gpu_os_12 (or _13).
export MM_IMAGE="${MM_IMAGE:-ubuntu_noble_gpu_os_12}"

# --- Names (used to find resources across up/down cycles) -------------------
export MM_SERVER_NAME="${MM_SERVER_NAME:-meetingmind-gpu}"
export MM_DATA_VOLUME_NAME="${MM_DATA_VOLUME_NAME:-meetingmind-data}"

# --- Sizes ------------------------------------------------------------------
# Root/boot volume — ephemeral, dies with the server. Keep modest; all heavy
# data (models, DB) lives on the persistent data volume.
export MM_ROOT_VOLUME_SIZE="${MM_ROOT_VOLUME_SIZE:-50GB}"

# Persistent data volume — survives server deletion. Holds the whole Docker
# data-root: Ollama models (~6GB), Postgres, Qdrant, images.
export MM_DATA_VOLUME_SIZE="${MM_DATA_VOLUME_SIZE:-100GB}"

# Block volume type. Legacy detachable SSD is "b_ssd". If your project is on
# Scaleway Block Storage (SBS) only, set MM_VOLUME_TYPE=sbs_volume and read the
# note in README.md ("Volume type").
export MM_VOLUME_TYPE="${MM_VOLUME_TYPE:-b_ssd}"

# --- Repo to deploy on the box ----------------------------------------------
export MM_REPO_URL="${MM_REPO_URL:-https://github.com/MeetingMind-AI/meetingmind-ai.git}"
export MM_REPO_BRANCH="${MM_REPO_BRANCH:-main}"

# Filesystem label for the data volume (used to find/mount it reliably).
export MM_DATA_LABEL="${MM_DATA_LABEL:-MMDATA}"
export MM_DATA_MOUNT="${MM_DATA_MOUNT:-/mnt/data}"
